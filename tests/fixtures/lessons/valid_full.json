          ]
        },
        {
          "type": "prose",
          "markdown": "`move_to_end` is O(1) on an `OrderedDict`, so a read costs no more than a plain dict lookup plus one relink.",
          "depth": "detail",
          "claims": [
            {
              "text": "`move_to_end` runs in constant time.",
              "backing": {"url": "https://docs.python.org/3/library/collections.html#collections.OrderedDict.move_to_end", "version": "3.12"}
            },
            {"text": "A read costs one dict lookup plus one relink.", "backing": {"spike_id": "read-cost"}},
            {"text": "Eviction never blocks a concurrent reader.", "backing": {"reason": "threading is out of scope"}}
          ]
        },
