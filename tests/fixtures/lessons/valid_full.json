      "type": "single_choice",
      "prompt": "Which end of an `OrderedDict` does `popitem(last=False)` remove from?",
      "options": [
        {"text": "The front, the oldest insertion.", "why": "`last=False` selects FIFO order."},
        {"text": "The back, the newest insertion.", "why": "That is the default `last=True`."}
      ],
      "correct": 0
    }
  ],
